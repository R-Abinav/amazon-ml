*.7z

# Images (keep structure but ignore large image files)
# Uncomment if you want to ignore all images
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.bmp
# *.tiff
# *.svg

# Keep important documentation and config files
!README.md
!requirements.txt
!*.md
!*.txt
!*.yml
!*.yaml
!*.json
!*.py
!*.ipynb
!*.sol
!*.ts
!*.tsx
!*.js
!*.jsx
!*.css
!*.html
!*.xml
!*.sh
!*.bat
!*.cmd

# Keep dataset structure but ignore actual data
!dataset/
!dataset/*.csv
!dataset/*.json
!dataset/*.txt

# Keep model notebooks but ignore outputs
!models/
!models/*.ipynb
!models/*.py

# Keep source code
!src/
!src/*.py
!src/*.ipynb
!src/*.ts
!src/*.tsx
!src/*.js
!src/*.jsx

# Keep configuration files
!*.config.*
!*.conf
!config/
!configs/

# Keep documentation
!docs/
!documentation/
!*.rst
!*.tex

# Keep tests
!test/
!tests/
!*_test.py
!test_*.py
